{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history3d.local/schemas/scene.schema.json",
  "title": "scene.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storyId",
    "contentRevision",
    "sceneRevision",
    "storyPath",
    "sourcesPath",
    "units",
    "upAxis",
    "handedness",
    "ground",
    "assets",
    "objects",
    "hotspotBindings",
    "cameras",
    "walkableBounds",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "storyId": { "$ref": "#/$defs/storyId" },
    "contentRevision": { "type": "integer", "minimum": 1 },
    "sceneRevision": { "type": "integer", "minimum": 1 },
    "storyPath": { "const": "story.json" },
    "sourcesPath": { "const": "sources.json" },
    "units": { "const": "m" },
    "upAxis": { "const": "Y" },
    "handedness": { "const": "right" },
    "ground": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "y"],
      "properties": {
        "type": { "const": "plane" },
        "y": { "type": "number" }
      }
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "hotspotBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/hotspotBinding" }
    },
    "cameras": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstPerson", "overview"],
      "properties": {
        "firstPerson": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spawnFeet",
            "eyeHeightM",
            "yawRad",
            "pitchRad",
            "moveSpeedMps",
            "radiusM"
          ],
          "properties": {
            "spawnFeet": { "$ref": "#/$defs/vec3" },
            "eyeHeightM": { "const": 1.7 },
            "yawRad": { "type": "number" },
            "pitchRad": { "type": "number" },
            "moveSpeedMps": { "type": "number", "exclusiveMinimum": 0 },
            "radiusM": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "overview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["position", "target", "up"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3" },
            "target": { "$ref": "#/$defs/vec3" },
            "up": { "$ref": "#/$defs/vec3" }
          }
        }
      }
    },
    "walkableBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vec2" },
        "max": { "$ref": "#/$defs/vec2" }
      }
    },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
  },
  "$defs": {
    "storyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)(?!/)(?!.*\\.\\.)(?!.*\\\\)[^/\\\\].*$"
    },
    "positiveVec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "dimensionsM", "format", "rights"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/relativePath" },
        "dimensionsM": { "$ref": "#/$defs/positiveVec3" },
        "format": { "const": "glb" },
        "rights": { "type": "string", "minLength": 1 }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "briefId",
        "label",
        "render",
        "position",
        "rotation",
        "scale",
        "dimensionsM",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "briefId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "render": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "shape", "color"],
              "properties": {
                "type": { "const": "primitive" },
                "shape": { "const": "box" },
                "color": { "$ref": "#/$defs/hexColor" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "assetId"],
              "properties": {
                "type": { "const": "asset" },
                "assetId": { "$ref": "#/$defs/id" }
              }
            }
          ]
        },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "const": 0 },
            { "type": "number" },
            { "const": 0 }
          ],
          "items": false
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [{ "const": 1 }, { "const": 1 }, { "const": 1 }],
          "items": false
        },
        "dimensionsM": { "$ref": "#/$defs/positiveVec3" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions", "appearance", "placement", "quantity"],
          "properties": {
            "dimensions": { "$ref": "#/$defs/claimIdList" },
            "appearance": { "$ref": "#/$defs/claimIdList" },
            "placement": { "$ref": "#/$defs/claimIdList" },
            "quantity": { "$ref": "#/$defs/claimIdList" }
          }
        }
      }
    },
    "claimIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/id" }
    },
    "hotspotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hotspotId", "anchor"],
      "properties": {
        "hotspotId": { "$ref": "#/$defs/id" },
        "anchor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "objectId", "offset"],
              "properties": {
                "type": { "const": "object" },
                "objectId": { "$ref": "#/$defs/id" },
                "offset": { "$ref": "#/$defs/vec3" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "position"],
              "properties": {
                "type": { "const": "world" },
                "position": { "$ref": "#/$defs/vec3" }
              }
            }
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "min": { "$ref": "#/$defs/vec2" },
        "max": { "$ref": "#/$defs/vec2" }
      }
    }
  }
}
