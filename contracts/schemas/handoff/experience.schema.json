{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["experienceVersion", "storyId", "sceneRevision", "durationSeconds", "beats", "tracks", "cameraCues", "environment", "audio"],
  "properties": {
    "experienceVersion": { "const": "1.0.0" },
    "storyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "sceneRevision": { "type": "integer", "minimum": 1 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "beats": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "startSeconds", "endSeconds", "focusObjectIds", "evidenceType"], "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "type": "string" }, "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "exclusiveMinimum": 0 }, "focusObjectIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "evidenceType": { "$ref": "#/$defs/evidence" } } } },
    "tracks": { "type": "array", "items": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["id", "type", "objectId", "keyframes", "evidenceType"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "transform" }, "objectId": { "$ref": "#/$defs/id" }, "keyframes": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["timeSeconds", "position", "yawRad"], "properties": { "timeSeconds": { "type": "number", "minimum": 0 }, "position": { "$ref": "#/$defs/vec3" }, "yawRad": { "type": "number" } } } }, "evidenceType": { "$ref": "#/$defs/evidence" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "type", "objectId", "keyframes", "evidenceType"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "visibility" }, "objectId": { "$ref": "#/$defs/id" }, "keyframes": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["timeSeconds", "visible"], "properties": { "timeSeconds": { "type": "number", "minimum": 0 }, "visible": { "type": "boolean" } } } }, "evidenceType": { "$ref": "#/$defs/evidence" } } },
      { "type": "object", "additionalProperties": false, "required": ["id", "type", "childObjectId", "parentObjectId", "localPosition", "localYawRad", "startSeconds", "endSeconds", "evidenceType"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "attachment" }, "childObjectId": { "$ref": "#/$defs/id" }, "parentObjectId": { "$ref": "#/$defs/id" }, "localPosition": { "$ref": "#/$defs/vec3" }, "localYawRad": { "type": "number" }, "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "exclusiveMinimum": 0 }, "evidenceType": { "$ref": "#/$defs/evidence" } } }
    ] } },
    "cameraCues": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "timeSeconds", "position", "target", "evidenceType"], "properties": { "id": { "$ref": "#/$defs/id" }, "timeSeconds": { "type": "number", "minimum": 0 }, "position": { "$ref": "#/$defs/vec3" }, "target": { "$ref": "#/$defs/vec3" }, "evidenceType": { "$ref": "#/$defs/evidence" } } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["keyframes"], "properties": { "keyframes": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["timeSeconds", "fogColor", "fogNearM", "fogFarM", "lightIntensity"], "properties": { "timeSeconds": { "type": "number", "minimum": 0 }, "fogColor": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" }, "fogNearM": { "type": "number", "minimum": 0 }, "fogFarM": { "type": "number", "exclusiveMinimum": 0 }, "lightIntensity": { "type": "number", "minimum": 0 } } } } } },
    "audio": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "startSeconds", "endSeconds", "loop", "volume", "defaultEnabled", "rights"], "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "type": "string", "minLength": 1 }, "startSeconds": { "type": "number", "minimum": 0 }, "endSeconds": { "type": "number", "exclusiveMinimum": 0 }, "loop": { "type": "boolean" }, "volume": { "type": "number", "minimum": 0, "maximum": 1 }, "defaultEnabled": { "const": false }, "rights": { "type": "string" } } } }
  },
  "$defs": { "id": { "type": "string", "minLength": 1 }, "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }, "evidence": { "enum": ["documented", "inferred", "illustrative"] } }
}
