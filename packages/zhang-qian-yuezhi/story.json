    {
      "id": "settled",
      "title": "安居的生活",
      "body": "《史记》描述月氏“地肥饶，少寇，志安乐”。史书记述他们所处的生活环境与取向；画面里的水源和牧地帮助理解这层处境，并非会见地点的复原。",
      "claimIds": [
        "claim-shiji-disposition"
      ]
    },
    {
      "id": "distance",
      "title": "遥远的汉朝",
      "body": "史书同时记下“又自以远汉”。地理上的遥远也是当时处境的一部分。这里不把古籍中的里数换算成精确现代路线，也不把观点写成虚构谈判对白。",
      "claimIds": [
        "claim-shiji-disposition"
      ]
    },
    {
      "id": "past",
      "title": "共同的旧敌",
      "body": "汉廷听闻月氏与匈奴的旧仇，因此希望通使。但关于抵达后的月氏，《史记》写“殊无报胡之心”。这两处记述共同解释了原先期待与实际结果之间的落差。",
      "claimIds": [
        "claim-shiji-mission",
        "claim-shiji-disposition"
      ]
    }
  ],
