{
  "name": "history3d",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "validate:collection": "node --import tsx scripts/validate-collection.ts",
    "validate:handoff": "node --import tsx scripts/validate-handoff.ts",
    "processing": "node --import tsx processing/src/cli.ts",
    "processing:server": "node --import tsx processing/src/server-main.ts",
    "collector:dev": "node --import tsx scripts/collector-server.ts --demo",
    "collector:publish": "node --import tsx scripts/collector-publish.ts",
    "agent:dev": "node --import tsx agent/server.ts",
    "validate:package": "node --import tsx scripts/validate-package.ts",
    "validate:yuezhi": "node --import tsx scripts/validate-yuezhi-package.ts",
    "yuezhi:prepare": "node --import tsx scripts/build-yuezhi-package.ts",
    "yuezhi:dev": "npm run yuezhi:prepare && npm run validate:yuezhi && npm run dev -- --host 127.0.0.1 --port 5191",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run validate:collection && npm run validate:package && npm run validate:yuezhi && npm run typecheck && npm run test",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run validate:collection && npm run validate:package && npm run validate:yuezhi && npm run prepare:assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "demo": "npm run build && npm run agent:dev"
  },
  "dependencies": {
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
