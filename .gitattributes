# Signed fixture and delivery digests require identical bytes on every platform.
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.glb binary
*.png binary
*.jpg binary
*.mp3 binary

# These trees contain byte-hashed delivery snapshots and original evidence.
# Preserve their verified line endings instead of applying text normalization.
packages/** -text
collector/deliveries/** -text
viewer/public/yuezhi/** -text
records/** -text
docs/historical/** -text

# Mural cinema includes immutable GLB digests and locally recorded narration.
*.m4a binary
viewer/public/mural-assets/** -text

# Validation payloads carry their original byte digests.
docs/handoff/mural-clarity/validation/** -text

# Frozen agent policies and exported web packages retain their original bytes.
agent/quality-policy*.json -text
agent/public-voice/public-voice-manifest.json -text
artifacts/bronze-horse-r14/** -text
